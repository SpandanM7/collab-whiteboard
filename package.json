{
  "name": "collab-whiteboard",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "test": "vitest run",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck -w server",
    "lint": "npm run lint -w client"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.12"
  }
}
